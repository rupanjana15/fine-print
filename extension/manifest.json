{
  "manifest_version": 3,
  "name": "Fine Print",
  "version": "1.0.0",
  "description": "Flags the clauses that matter in Terms of Service, with a severity and the exact quote. Runs on your own computer.",
  "action": { "default_popup": "popup.html", "default_title": "Fine Print" },
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:8737/*"],
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
